{{ if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/bash
{{ else -}}
#!/usr/bin/env bash
{{ end -}}
set -euo pipefail

NVIM_CONFIG="$HOME/.config/nvim"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"
source "$SOURCE_DIR/scripts/lib.sh"

install_neovim_deb() {
  local arch url tmp
  arch="$(detect_arch)"
  url="https://github.com/neovim/neovim-releases/releases/latest/download/nvim-linux-${arch}.deb"
  tmp="/tmp/nvim-linux-${arch}.deb"

  curl -fL "$url" -o "$tmp"
  sudo apt-get update
  sudo apt-get install -y "$tmp"
  rm -f "$tmp"
}

# back up existing config if present
if [[ -d "$NVIM_CONFIG" && ! -d "${NVIM_CONFIG}.bak" ]]; then
  mv "$NVIM_CONFIG" "${NVIM_CONFIG}.bak"
fi

# clone LazyVim starter if not already present
if [[ ! -d "$NVIM_CONFIG" ]]; then
  git clone https://github.com/LazyVim/starter "$NVIM_CONFIG"
  rm -rf "$NVIM_CONFIG/.git"
fi
