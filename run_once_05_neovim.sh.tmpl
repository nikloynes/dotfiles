{{ if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/bash
{{ else -}}
#!/usr/bin/env bash
{{ end -}}
set -euo pipefail

NVIM_CONFIG="$HOME/.config/nvim"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"
source "$SOURCE_DIR/scripts/lib.sh"

elif [[ "{{ .chezmoi.os }}" == "linux" ]]; then  
  # note - this will throw an error for steamos!
  sudo add-apt-repository ppa:neovim-ppa/stable -y
  sudo apt update 
  sudo apt install neovim
  # echo "installing neovim from snap..."
  # if command -v snap >/dev/null 2>&1; then
  #   sudo snap install nvim --classic
  # else
  #   echo "snap not installed, installing..."
  #   sudo apt install snapd
  # fi
fi

# back up existing config if present
if [[ -d "$NVIM_CONFIG" && ! -d "${NVIM_CONFIG}.bak" ]]; then
  mv "$NVIM_CONFIG" "${NVIM_CONFIG}.bak"
fi

# clone LazyVim starter if not already present
if [[ ! -d "$NVIM_CONFIG" ]]; then
  git clone https://github.com/LazyVim/starter "$NVIM_CONFIG"
  rm -rf "$NVIM_CONFIG/.git"
fi
