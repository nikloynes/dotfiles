{{ if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/bash
{{ else -}}
#!/usr/bin/env bash
{{ end -}}
set -euo pipefail

NVIM_CONFIG="$HOME/.config/nvim"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"
source "$SOURCE_DIR/scripts/lib.sh"

if is_raspberry_pi; then
  echo "installing neovim from GH for newest version due to slow raspbian..."
  echo "this will take forever. get a coffee."
  git clone https://github.com/neovim/neovim.git
  cd neovim
  make CMAKE_BUILD_TYPE=RelWithDebInfo
  cd build
  cpack -G DEB
  sudo dpkg -i nvim-linux64.deb
fi

# back up existing config if present
if [[ -d "$NVIM_CONFIG" && ! -d "${NVIM_CONFIG}.bak" ]]; then
  mv "$NVIM_CONFIG" "${NVIM_CONFIG}.bak"
fi

# clone LazyVim starter if not already present
if [[ ! -d "$NVIM_CONFIG" ]]; then
  git clone https://github.com/LazyVim/starter "$NVIM_CONFIG"
  rm -rf "$NVIM_CONFIG/.git"
fi