{{ if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/bash
{{ else -}}
#!/usr/bin/env bash
{{ end -}}
set -euo pipefail

SOURCE_DIR="{{ .chezmoi.sourceDir }}"

source "$SOURCE_DIR/scripts/lib.sh"

install_apt_packages() {
  local file="$1"
  local pkg
  local pkgs=()

  while IFS= read -r pkg || [[ -n "$pkg" ]]; do
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    if apt-cache show "$pkg" >/dev/null 2>&1; then
      pkgs+=("$pkg")
    else
      echo "Skipping missing package: $pkg"
    fi
  done < "$file"

  if ((${#pkgs[@]})); then
    sudo apt-get install -y "${pkgs[@]}"
  fi
}

if [[ "{{ .chezmoi.os }}" == "darwin" ]]; then
  brew bundle --file "$SOURCE_DIR/Brewfile"

elif [[ "{{ .chezmoi.os }}" == "android" ]]; then
  pkg update -y
  xargs -a "$SOURCE_DIR/packages/termux.txt" pkg install -y

elif [[ "{{ .chezmoi.os }}" == "linux" ]]; then
  if is_raspberry_pi; then
    sudo apt-get update
    install_apt_packages "$SOURCE_DIR/packages/raspberrypi.txt"

  elif grep -qi '^ID=steamos' /etc/os-release 2>/dev/null; then
    if command -v brew >/dev/null 2>&1; then
      brew bundle --file "$SOURCE_DIR/Brewfile.linux"
    else
      echo "Homebrew not found on SteamOS"
    fi

  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    install_apt_packages "$SOURCE_DIR/packages/apt.txt"

  else
    echo "No supported package manager found"
  fi
fi

if ! command -v atuin >/dev/null 2>&1; then
  if is_raspberry_pi; then
    ATUIN_VERSION="18.12.0"
    curl --proto '=https' --tlsv1.2 -LsSf \
      "https://github.com/atuinsh/atuin/releases/download/v${ATUIN_VERSION}/atuin-installer.sh" | sh
  elif [[ "{{ .chezmoi.os }}" != "android" ]]; then
    curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
  fi
fi

if ! command -v uv >/dev/null 2>&1; then
  if [[ "{{ .chezmoi.os }}" != "android" ]]; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
  else
    echo "Skipping uv install: not supported on Android/Termux"
  fi
fi

UV="$HOME/.local/bin/uv"
if [[ -f "$UV" ]]; then
  "$UV" tool install ruff
  "$UV" tool install basedpyright
  "$UV" python install 3.14
  "$UV" python pin 3.14
fi
