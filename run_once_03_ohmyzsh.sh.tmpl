{{ if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/bash
{{ else -}}
#!/usr/bin/env bash
{{ end -}}
set -euo pipefail

if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# set zsh as default shell if not already
ZSH_PATH="$(command -v zsh)"
if [[ "$SHELL" != "$ZSH_PATH" ]]; then
  if [[ "{{ .chezmoi.os }}" == "darwin" ]]; then
    # macOS: chsh doesn't need sudo for the current user
    if ! grep -qF "$ZSH_PATH" /etc/shells; then
      echo "$ZSH_PATH" | sudo tee -a /etc/shells
    fi
    chsh -s "$ZSH_PATH"
  elif [[ "{{ .chezmoi.os }}" != "android" ]]; then
    # Linux (Ubuntu, Raspberry Pi, SteamOS): usermod is reliable in non-interactive scripts
    if ! grep -qF "$ZSH_PATH" /etc/shells; then
      echo "$ZSH_PATH" | sudo tee -a /etc/shells
    fi
    sudo usermod --shell "$ZSH_PATH" "$USER"
  fi
  # Termux (android): shell is managed by Termux itself, skip
fi
